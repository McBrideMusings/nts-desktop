<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">

<!--
  NTS Radio's scripting dictionary — the app's control surface for anything that
  is not a human with a mouse.

      osascript -e 'tell application "NTS Radio" to get state'
      osascript -e 'tell application "NTS Radio" to tune to "mixtape:rap-house"'
      osascript -e 'tell application "NTS Radio" to pause'

  Every command answers with the same JSON blob `state` returns, so a script can
  act and observe what the act did in one round trip.

  Deliberately absent: anything that activates the app or takes keyboard focus.
  `open window` uses orderFrontRegardless, so a scripted open puts the window on
  screen without stealing what the person at the keyboard is typing into.
-->

<dictionary title="NTS Radio Terminology" xmlns:xi="http://www.w3.org/2003/XInclude">

    <xi:include href="file:///System/Library/ScriptingDefinitions/CocoaStandard.sdef"
                xpointer="xpointer(/dictionary/suite)"/>

    <suite name="NTS Radio Suite" code="NTSr" description="Read and drive the radio.">

        <class-extension extends="application" description="The NTS Radio application.">
            <cocoa class="NSApplication"/>

            <property name="state" code="pSTA" type="text" access="r"
                      description="Everything the app knows about itself right now, as a JSON object.">
                <cocoa key="ntsState"/>
            </property>

            <property name="playing" code="pPLY" type="boolean" access="r"
                      description="Whether the play button is down. True even while a stream is still buffering.">
                <cocoa key="ntsPlaying"/>
            </property>

            <property name="rendering" code="pRND" type="boolean" access="r"
                      description="Whether audio is genuinely coming out. False during a stall, unlike playing.">
                <cocoa key="ntsRendering"/>
            </property>

            <property name="source" code="pSRC" type="text" access="r"
                      description="What is tuned in, as an identifier: mixtape:&lt;alias&gt;, channel:&lt;number&gt;, episode:&lt;show&gt;/&lt;episode&gt;, or idle.">
                <cocoa key="ntsSource"/>
            </property>

            <property name="source name" code="pSNM" type="text" access="r"
                      description="The tuned source's display title — the mixtape's name, or the channel's current show.">
                <cocoa key="ntsSourceName"/>
            </property>

            <property name="current track" code="pTRK" type="text" access="r"
                      description="The newest tracklist entry as 'artist — title'. Empty when signed out; the feed is supporter-gated.">
                <cocoa key="ntsCurrentTrack"/>
            </property>

            <property name="volume" code="pVOL" type="integer"
                      description="Output level, 0 to 100. This is the gain, not the knob position: the state's volumeSlider reports where the knob sits for the current volume curve.">
                <cocoa key="ntsVolume"/>
            </property>

            <property name="volume curve" code="pVCV" type="text"
                      description="How the volume knob maps to the output level: linear or perceptual. Changing it keeps the volume and moves the knob. Anything else is an error.">
                <cocoa key="ntsVolumeCurve"/>
            </property>

            <property name="volume steepness" code="pVST" type="real"
                      description="The perceptual curve's exponent, 2 (gentle) to 5 (steep). Values outside that range are clamped. Has no effect while the curve is linear.">
                <cocoa key="ntsVolumeSteepness"/>
            </property>

            <property name="muted" code="pMUT" type="boolean"
                      description="Whether output is silenced without changing volume.">
                <cocoa key="ntsMuted"/>
            </property>

            <property name="track lead" code="pTLD" type="text"
                      description="Which line leads each tracklist row: 'title' (the default) or 'artist'. Any other value is an error.">
                <cocoa key="ntsTrackLead"/>
            </property>

            <property name="window visible" code="pWIN" type="boolean" access="r"
                      description="Whether the radio window is on screen.">
                <cocoa key="ntsWindowVisible"/>
            </property>

            <property name="knob angle" code="pKNB" type="real" access="r"
                      description="Where the dial's index mark points, in degrees clockwise from the top. It counts turns instead of wrapping at 360, so comparing two readings tells you which way the dial turned and how far.">
                <cocoa key="ntsKnobAngle"/>
            </property>

            <property name="auto checks for updates" code="pAUP" type="boolean"
                      description="Whether Sparkle checks for updates on its own schedule, the same toggle as Settings ▸ General.">
                <cocoa key="ntsAutoChecksForUpdates"/>
            </property>
        </class-extension>

        <command name="tune to" code="NTSrTUNE"
                 description="Tune to a mixtape, a channel or an episode and start playing it, the same as clicking it. Tuning to idle is the same as stop.">
            <cocoa class="NTSTuneCommand"/>
            <direct-parameter type="text"
                              description="mixtape:&lt;alias&gt;, channel:&lt;number&gt;, episode:&lt;show&gt;/&lt;episode&gt;, or idle — for example mixtape:rap-house, channel:1, or episode:lung-dart/lung-dart-10th-august-2026."/>
            <parameter name="until rendering" code="pUNR" type="boolean" optional="yes"
                       description="When true, wait to answer until audio is coming out, the episode fetch has failed, or 10 seconds have passed. Without it the reply comes back at once, before the new stream has started.">
                <cocoa key="untilRendering"/>
            </parameter>
            <result type="text" description="The state after tuning, as JSON."/>
        </command>

        <command name="stop" code="NTSrSTOP"
                 description="Stop playing and untune, back to idle — the state the app launches in. Unlike pause, nothing stays loaded.">
            <cocoa class="NTSStopCommand"/>
            <result type="text" description="The state after stopping, as JSON."/>
        </command>

        <command name="play" code="NTSrPLAY"
                 description="Start the tuned source. Does nothing when nothing is tuned.">
            <cocoa class="NTSPlayCommand"/>
            <result type="text" description="The state after starting, as JSON."/>
        </command>

        <command name="pause" code="NTSrPAUS" description="Pause playback, keeping the tuned source.">
            <cocoa class="NTSPauseCommand"/>
            <result type="text" description="The state after pausing, as JSON."/>
        </command>

        <command name="skip" code="NTSrSKIP"
                 description="Move to a neighbouring source within the current group, as the next/previous-track keys do. Mixtapes walk the dial and the two channels toggle, both wrapping at the ends. Playing state carries over. Fails on an episode or when idle, which have no neighbours.">
            <cocoa class="NTSSkipCommand"/>
            <parameter name="by" code="pBY_" type="integer" optional="yes"
                       description="How many positions to move, negative for backwards. Defaults to 1. Counts past either end wrap around, so with 16 mixtapes skip by 16 lands where it started.">
                <cocoa key="by"/>
            </parameter>
            <parameter name="until rendering" code="pUNR" type="boolean" optional="yes"
                       description="When true, wait to answer until audio is coming out, or 10 seconds have passed. A skip while paused answers at once.">
                <cocoa key="untilRendering"/>
            </parameter>
            <result type="text" description="The state after skipping, as JSON."/>
        </command>

        <command name="seek to" code="NTSrSEEK"
                 description="Move the playhead within a past episode, the same as dragging the seek bar. Fails on a live channel or a mixtape, which have no position to move to.">
            <cocoa class="NTSSeekCommand"/>
            <direct-parameter type="real" description="Seconds from the start of the episode."/>
            <result type="text" description="The state after seeking, as JSON."/>
        </command>

        <command name="open window" code="NTSrOPNW"
                 description="Put the radio window on screen without activating the app or taking keyboard focus.">
            <cocoa class="NTSOpenWindowCommand"/>
            <result type="text" description="The state after opening, as JSON."/>
        </command>

        <command name="close window" code="NTSrCLSW" description="Take the radio window off screen.">
            <cocoa class="NTSCloseWindowCommand"/>
            <result type="text" description="The state after closing, as JSON."/>
        </command>

        <command name="open catalog" code="NTSrOPNC"
                 description="Cover the faceplate with the catalog, the same as clicking the grid button, and optionally choose which list it shows.">
            <cocoa class="NTSOpenCatalogCommand"/>
            <parameter name="showing" code="pTAB" type="text" optional="yes"
                       description="schedule or saved. Defaults to whichever list was last open.">
                <cocoa key="showing"/>
            </parameter>
            <parameter name="channel" code="pSCH" type="integer" optional="yes"
                       description="Which channel's grid the schedule timeline shows, 1 or 2.">
                <cocoa key="channel"/>
            </parameter>
            <parameter name="searching for" code="pQRY" type="text" optional="yes"
                       description="A search term. A non-empty term searches shows and mixtapes together instead of showing the list.">
                <cocoa key="searchingFor"/>
            </parameter>
            <result type="text" description="The state after opening, as JSON."/>
        </command>

        <command name="filter explore" code="NTSrFLTR"
                 description="Set Explore's filters, the same as clicking the mood chips, genre drawer and toggles. Anything left out is cleared, so one call states the whole filter.">
            <cocoa class="NTSFilterExploreCommand"/>
            <parameter name="mood" code="pMOD" type="text" optional="yes"
                       description="A mood id, e.g. sedative or nosebleed. Omit for no mood.">
                <cocoa key="mood"/>
            </parameter>
            <parameter name="genres" code="pGNR" type="list of text" optional="yes"
                       description="Genre ids, e.g. {&quot;ambientnewage&quot;, &quot;avantgarde-experimental&quot;}. They stack.">
                <cocoa key="genres"/>
            </parameter>
            <parameter name="music only" code="pMUS" type="boolean" optional="yes"
                       description="nts.live's Music Only — episodes tagged no-talkin.">
                <cocoa key="musicOnly"/>
            </parameter>
            <parameter name="focused" code="pFOC" type="boolean" optional="yes"
                       description="nts.live's Focused — episodes tagged with exactly as many genres as are selected.">
                <cocoa key="focused"/>
            </parameter>
            <result type="text" description="The state after filtering, as JSON. The results arrive asynchronously — read state again to see them."/>
        </command>

        <command name="explore more" code="NTSrMORE"
                 description="Load Explore's next page of results, the same as scrolling to the bottom of the grid.">
            <cocoa class="NTSExploreMoreCommand"/>
            <result type="text" description="The state after asking, as JSON. The page arrives asynchronously — read state again to see it."/>
        </command>

        <command name="star" code="NTSrSTAR"
                 description="Star or unstar a show or an episode, the same as clicking the star on its tile. Signed in, this also writes to (or deletes from) your NTS account's favourites.">
            <cocoa class="NTSStarCommand"/>
            <direct-parameter type="text" description="A show alias, e.g. lung-dart, or episode:&lt;show&gt;/&lt;episode&gt;, e.g. episode:lung-dart/lung-dart-10th-august-2026."/>
            <result type="text" description="The state after starring, as JSON."/>
        </command>

        <command name="browse genre" code="NTSrBRWS"
                 description="Open the archive filtered to one genre, the same as clicking a genre chip on a channel card.">
            <cocoa class="NTSBrowseCommand"/>
            <direct-parameter type="text" description="The genre by the name the card prints, e.g. Kosmische. Fails for a genre Explore does not file, which is the case the card leaves as plain text."/>
            <result type="text" description="The state after opening, as JSON."/>
        </command>

        <command name="open show" code="NTSrSHOW"
                 description="Open a show's page in the archive — its blurb, genre and mood tags, and its episodes — the same as clicking its tile.">
            <cocoa class="NTSOpenShowCommand"/>
            <direct-parameter type="text" description="A show alias, e.g. veronica-vasicka."/>
            <result type="text" description="The state after opening, as JSON."/>
        </command>

        <command name="open settings" code="NTSrSETT"
                 description="Open the Settings window — the same window ⌘, opens, not a panel inside the radio window.">
            <cocoa class="NTSOpenSettingsCommand"/>
            <direct-parameter type="text" optional="yes" description="Which pane to show: general or account. Defaults to whichever is already showing."/>
            <result type="text" description="The state after opening, as JSON."/>
        </command>

        <command name="show pane" code="NTSrPANE"
                 description="Go to a pane, the same as clicking a segment of the switch in the now-playing bar, or raise the tracklist drawer over whichever pane is up.">
            <cocoa class="NTSShowPaneCommand"/>
            <direct-parameter type="text" description="live or catalog; tracks raises the tracklist drawer, none drops it."/>
            <result type="text" description="The state after switching, as JSON."/>
        </command>

        <command name="close catalog" code="NTSrCLSC"
                 description="Uncover the faceplate, dropping any search term and open detail.">
            <cocoa class="NTSCloseCatalogCommand"/>
            <result type="text" description="The state after closing, as JSON."/>
        </command>

        <command name="check for updates" code="NTSrUPDT"
                 description="Ask Sparkle to check for an update now, the same as the status menu's or the main menu's Check for Updates… item. Sparkle may put up its own window to report what it found.">
            <cocoa class="NTSCheckForUpdatesCommand"/>
            <result type="text" description="The state after asking, as JSON."/>
        </command>

    </suite>
</dictionary>
